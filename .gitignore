# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (deployment builds into .next-build and keeps the last build as .next-previous)
/.next/
/.next-build/
/.next-previous/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# admin panel data and uploaded photos (lives on the server, not in git)
/storage

# Passenger restart trigger written by .cpanel.yml on each deploy
/tmp/

# Passenger error log written next to server.js on cPanel
/stderr.log
