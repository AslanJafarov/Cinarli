# Public origin for canonical URLs, the sitemap and link previews (build time).
NEXT_PUBLIC_SITE_URL=https://chinarlipark.az
# Set these through the host environment; never commit real credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Persistent directory outside the application folder (site.json, leads.json, uploads/).
DATA_DIR=
# Set only to a header overwritten/appended by the trusted reverse proxy, e.g. X-Forwarded-For.
# The final comma-separated address is used. Unconfigured: all submissions share one 120/minute bucket.
TRUSTED_CLIENT_IP_HEADER=
# Optional copy of every lead to a Google Sheet (docs/google-sheets.md): the Apps Script web app
# URL and the secret it checks. Leave empty to keep leads in the admin panel only.
LEADS_SHEET_URL=
LEADS_SHEET_SECRET=
